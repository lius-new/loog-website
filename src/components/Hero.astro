---
// 首屏:点阵画布在最底层(scripts/dots.ts 绘制),舞台在上,舞台里左栏 + 编辑器窗口。
import Intro from './Intro.astro';
import QuickLinks from './QuickLinks.astro';
import FeatureIndex from './FeatureIndex.astro';
import AppWindow from './AppWindow.astro';
import { SITE } from '../data/site';
---

<div class="hero" id="hero">
  <!-- 画布上的点阵字标就是视觉上的标题;这里给读屏和搜索引擎一个完整的文字版 -->
  <h1 class="sr">{SITE.name}: {SITE.subtitle}</h1>
  <canvas id="field" aria-hidden="true"></canvas>

  <div class="stage" id="stage">
    <div class="info">
      <Intro />
      <QuickLinks />
      <FeatureIndex />
    </div>
    <AppWindow />
  </div>
</div>
